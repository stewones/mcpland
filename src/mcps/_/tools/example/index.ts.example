import z from 'zod';

import { fetchWithRetry, McpTool, type McpToolSpec } from 'mcpland';

import type { ServerResult } from '@modelcontextprotocol/sdk/types.js';

// Optional: Add a context URL or file for this tool
// const contextUrl = 'https://example.com/api/docs';
// const contextFile = './context.md';
const chunkOptions = { maxChars: 1200, overlap: 200 };

const spec: McpToolSpec = {
	name: '{{TOOL_NAME}}',
	description: '{{TOOL_DESCRIPTION}}',
	sourceId: '{{MCP_NAME}}-{{TOOL_NAME}}-context',
	// contextUrl, // Uncomment if you have a context URL
	// contextFile, // Uncomment if you have a context file
	chunkOptions,
	schema: z.object({
		query: z
			.string()
			.min(2)
			.describe('Query parameter for the {{TOOL_NAME}} tool'),
		limit: z
			.number()
			.int()
			.min(1)
			.max(50)
			.optional()
			.describe('Number of results to return (default 20)'),
	}),
};

export class {{TOOL_CLASS_NAME}}Tool extends McpTool {
	constructor() {
		super(spec);
	}

	/**
	 * Fetch initial context for this tool
	 * This is automatically called at MCP initialization
	 */
	async fetchContext(): Promise<string> {
		// If you have a contextUrl, fetch from it:
		// const res = await fetchWithRetry(this.spec.contextUrl!);
		// return res.text();
		
		// If you have a contextFile, read from it:
		// const fs = await import('node:fs');
		// const path = await import('node:path');
		// const filePath = path.join(this.getToolPath(), this.spec.contextFile!);
		// return fs.readFileSync(filePath, 'utf-8');
		
		// For now, return a simple context string
		return `
This is the context for the {{TOOL_NAME}} tool in the {{MCP_NAME}} MCP.
You can customize this by:
1. Adding a contextUrl to fetch context from a web API
2. Adding a contextFile to read context from a local file
3. Implementing custom logic to generate context dynamically

Tool capabilities:
- Process queries with the 'query' parameter
- Return configurable number of results with 'limit' parameter
- Provide context-aware responses based on the embedded knowledge

Usage examples:
- Simple query: { "query": "how to use this tool" }
- Limited results: { "query": "examples", "limit": 5 }
		`.trim();
	}

	/**
	 * Handle context for user inquiries
	 * You can customize this method to implement your tool's logic
	 */
	async handleContext(args: unknown): Promise<ServerResult> {
		const parsed = spec.schema.safeParse(args);
		if (!parsed.success) {
			return {
				content: [
					{
						type: 'text',
						text: JSON.stringify({
							error: 'Invalid arguments',
							details: parsed.error.errors,
						}),
					},
				],
			};
		}

		const { query, limit } = parsed.data;
		
		// Search the embedded context for relevant information
		const results = await this.searchContext(query, limit);

		if (results.length === 0) {
			return {
				content: [
					{
						type: 'text',
						text: `No relevant context found for query: "${query}". You may need to add more context to this tool or check your query.`,
					},
				],
			};
		}

		// Format the results for display
		const payload = results
			.map(
				(r, i) =>
					`[[Result ${i + 1} | relevance=${r.score.toFixed(3)}]]\n${r.content}`
			)
			.join('\n\n');

		return {
			content: [
				{
					type: 'text',
					text: `Found ${results.length} relevant result(s) for "${query}":\n\n${payload}`,
				},
			],
		};
	}
}

export default new {{TOOL_CLASS_NAME}}Tool();
