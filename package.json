{
  "name": "mcpland",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "description": "Building blocks for implementing Model Context Protocol tools.",
  "bin": {
    "mcp": "./src/bin.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stewones/mcpland.git"
  },
  "scripts": {
    "build": "bun run format && bun run ./scripts/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --config=vitest.config.ts",
    "coverage": "bun run test:coverage && open coverage/index.html",
    "coverage:ci": "bun run ./scripts/coverage.ts",
    "format": "format-imports ./src --config=./import.json && format-imports ./test --config=./import.json",
    "badges": "bun run ./scripts/badges.ts",
    "publish": "bun run build && cd dist && npm publish"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./sse": {
      "types": "./types/sse.d.ts",
      "default": "./sse.js"
    }
  },
  "files": [
    "types",
    "index.js",
    "index.js.map",
    "bin.js",
    "bin.js.map",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@ai-sdk/openai": "^2.0.5",
    "@clack/prompts": "^0.11.0",
    "@elysiajs/cors": "^1.3.3",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "ai": "^5.0.8",
    "elysia": "^1.3.21",
    "figlet": "^1.8.2",
    "is-unicode-supported": "^2.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/figlet": "^1.7.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dedent": "^1.6.0",
    "format-imports": "^4.0.8",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
